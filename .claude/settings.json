{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(supabase db reset:*)",
      "Bash(supabase db push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin :refs/tags/*)",
      "Bash(git tag -d:*)",
      "Bash(git push --delete:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
