{
  "$schema": "https://typedoc.org/schema.json",

  /*
   * Shared by every package's typedoc.json.
   *
   * These options must live here rather than in the root typedoc.json: in
   * "packages" mode TypeDoc converts each package using that package's own
   * config, so root-level validation settings would never run against the
   * source. Extending this file is what makes them apply.
   *
   * Master Plan §5.1: "code without a doc-comment is unfinished code."
   * An exported symbol with no TSDoc comment, or a broken {@link}, fails here.
   */
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,

  /*
   * Which reflection kinds must carry a doc comment.
   *
   * This is TypeDoc's default list minus "Property". The reason is Zod: a
   * `z.enum([...])` schema exposes one internal property per member, so
   * `RoleSchema.__type.striker` and its four siblings are each reported as an
   * undocumented Property. There is no source location to attach a comment to —
   * they are generated by Zod's types, not written by us — so enforcing Property
   * would mean either abandoning z.enum or permanently failing the build.
   *
   * The cost is that object-shape properties are no longer machine-checked. We
   * still document them by hand (see PositionSchema, PlayerSchema, MatchStateSchema);
   * it is now convention rather than a gate. Everything we actually name and
   * export — functions, variables, types, interfaces, their methods — is still
   * enforced, which is where the real risk of undocumented API lives.
   */
  "requiredToBeDocumented": [
    "Enum",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias"
  ]
}
