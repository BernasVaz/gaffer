# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# turborepo cache
.turbo/

# test + coverage output
coverage/
playwright-report/
test-results/
blob-report/

# generated API docs
docs/api/

# environment / secrets — never commit these
.env
.env.*
!.env.example

# editor + OS noise
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# machine-local Claude Code state
.claude/settings.local.json

# Word copy of the master plan — binary, not diffable.
# The canonical version is docs/MASTER_PLAN.md.
*.docx

# Binaries, which git is the wrong tool for.
#
# A 137 MB installer once landed in FeedbackLogs/ and a blind `git add -A` swept
# it into a commit; GitHub rejected the push at 100 MB and the commit had to be
# unpicked. Nothing here is diffable, reviewable, or something a clone should
# have to carry.
#
# Feedback *reports* are deliberately not covered: they are small, plain
# Markdown, and they are the input to the between-wave synthesis.
*.dmg
*.pkg
*.iso
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.exe
*.msi
*.app/
*.mp4
*.mov
*.avi

# Tester feedback stays out of the repository.
#
# Feedback is attacker-controlled text about this project, and a repository is
# a place where text gets read as instructions — by a person skimming a diff,
# and by whatever is reading the codebase to work on it. It lives in the
# database and in exports (`tools/backup`), and what reaches here is an issue
# somebody has read and approved, in their own words.
#
# Bernardo's own dogfood notes predate this and are his to keep; anything from
# an outside tester is ignored by default.
FeedbackLogs/*.md
!FeedbackLogs/gaffer-feedback-11v11-seed1319726635.md

# Database exports — they contain other people's writing.
backups/
*.backup.json
